{
  "name": "@magna/app-mail",
  "version": "0.1.0",
  "private": true,
  "description": "Your real mailbox, over IMAP or Microsoft 365.",
  "type": "module",
  "main": "lib/index.js",
  "license": "MIT",
  "exports": {
    ".": "./lib/index.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "client"
  ],
  "magna": {
    "appId": "mail",
    "title": "Mail",
    "publisher": "Magna",
    "permissions": {
      "grant": [
        "mail:read",
        "mail:send",
        "net:egress"
      ],
      "deny": [
        "fs:write"
      ]
    },
    "category": "Connect",
    "tagline": "Your real mailbox, over IMAP or Microsoft 365.",
    "glyph": "✉"
  },
  "dependencies": {
    "imapflow": "^1.0.0",
    "mailparser": "^3.7.0",
    "nodemailer": "^7.0.0"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-tools": "^0.1.0-rc.7",
    "zod": "^4.0.0"
  }
}
